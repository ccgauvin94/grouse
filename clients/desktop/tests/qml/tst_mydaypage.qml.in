import QtQuick
import QtTest
import "@MYDAY_UI_URL@"

// MyDayPage's grouping, which is the only non-obvious rule on the page: a thread
// LABEL groups rows, and a label gets a header only when more than one row sits
// under it (at the last count My Day held 21 entries over 19 labels, so a header
// per label would be all headers and no rows).
//
// Instantiating the page is half the point: its rows are Loaders over inline
// components, and a binding TypeError at delegate creation is exactly what
// qmllint and the page-load smoke cannot see. The stub Mgr comes from the
// runner's Setup context property (tests/qml/tst_qml.cpp).
TestCase {
    id: tc
    name: "MyDayPage"
    width: 900
    height: 700

    Component {
        id: pageComp
        MyDayPage { }
    }

    function makePage() {
        const page = pageComp.createObject(tc)
        verify(page !== null, "MyDayPage failed to instantiate")
        wait(50)   // let the entry sequence bind
        return page
    }

    function test_threadWithSeveralRowsGetsAHeader() {
        const page = makePage()
        const model = page.entryModel
        // Handed-over work first (1 task), then the two open loops in that thread,
        // then the unlabelled loop: one header for "chami-billing", no header for
        // the blank label.
        const headers = model.filter((e) => e.type === "header")
        compare(headers.length, 1)
        compare(headers[0].label, "chami-billing")
        compare(headers[0].count, 3)
        // Open by DEFAULT: the header annotates its rows, it does not withhold them.
        // (A board that arrives folded behind a chevron is not inline.)
        compare(headers[0].open, true)
        compare(model.length, 5)          // header + 3 rows + the unlabelled loop
        const lone = model.filter((e) => e.row && e.row.id === "itm_c")
        compare(lone.length, 1)
        page.destroy()
    }

    function test_foldingAThreadHidesItsRowsAndUnfoldingBringsThemBack() {
        const page = makePage()
        // Its rows are already in the sequence (open by default); the chevron only
        // takes them away, then puts them back.
        page.toggleLabel("chami-billing")
        wait(20)
        compare(page.entryModel.length, 2)      // header + the unlabelled loop
        page.toggleLabel("chami-billing")
        wait(20)
        const model = page.entryModel
        compare(model.length, 5)          // header + 3 rows + the unlabelled loop
        compare(model[0].type, "header")
        compare(model[0].open, true)
        // NEWEST FIRST: the group is a timeline of when rows were added, so the item
        // added today leads and the one added a month ago trails — handed-over work no
        // longer jumps the queue just for being a task.
        compare(model[1].row.id, "itm_b")
        compare(model[2].row.id, "tsk_a")
        compare(model[2].type, "task")
        compare(model[3].row.id, "itm_a")
        // A lone label never collapses: its row is in the same sequence, always.
        const lone = model.filter((e) => e.row && e.row.id === "itm_c")
        compare(lone.length, 1)
        page.destroy()
    }

    // A row behind a thread header is painted narrower than a row that stands on its
    // own. The flag alone would not prove that — the delegate is what moves — so this
    // also reads the laid-out x of both cards and requires the grouped one to be in.
    function findLoaderWithRowId(item, id, out) {
        const kids = item.children || []
        for (let i = 0; i < kids.length; i++) {
            const kid = kids[i]
            if (kid.entry !== undefined && kid.entry.row !== undefined
                    && kid.entry.row.id === id)
                out.push(kid)
            findLoaderWithRowId(kid, id, out)
        }
        return out
    }

    function test_groupedRowsAreIndentedUnderTheirHeader() {
        const page = makePage()
        // The unlabelled loop has no header, so it can never be nested.
        const loneEntry = page.entryModel.filter((e) => e.row && e.row.id === "itm_c")
        compare(loneEntry.length, 1)
        compare(loneEntry[0].indented, false)

        // Open by DEFAULT: a board that arrives folded behind a chevron is not inline.
        // No toggle here on purpose — the rows have to be in the sequence unprompted.
        let grouped = page.entryModel.filter(
            (e) => e.type !== "header" && e.label === "chami-billing")
        compare(grouped.length, 3)          // the handed-over task + two loops
        for (let i = 0; i < grouped.length; i++)
            compare(grouped[i].indented, true)

        const lone = findLoaderWithRowId(page, "itm_c", [])
        const nested = findLoaderWithRowId(page, "tsk_a", [])
        compare(lone.length, 1)
        compare(nested.length, 1)
        verify(nested[0].x > lone[0].x,
               "the grouped card is not in from the header: " + nested[0].x + " vs " + lone[0].x)

        // …and the chevron still folds it away, then back.
        page.toggleLabel("chami-billing")
        wait(50)
        grouped = page.entryModel.filter(
            (e) => e.type !== "header" && e.label === "chami-billing")
        compare(grouped.length, 0)
        page.toggleLabel("chami-billing")
        wait(50)
        grouped = page.entryModel.filter(
            (e) => e.type !== "header" && e.label === "chami-billing")
        compare(grouped.length, 3)
        page.destroy()
    }

    // The page paints a TIMELINE: rows carry the stamp the assistant added them with,
    // so the order has to be that stamp or the dates read as noise. A row with no
    // stamp at all sorts last rather than to the top (epoch zero would do that).
    function test_rowsAreOrderedNewestFirst() {
        const page = makePage()
        const ids = page.inPlayRows.map((r) => r.row.id)
        compare(ids, ["itm_b", "tsk_a", "itm_c", "itm_a"])
        page.destroy()
    }

    function test_aRowWithNoStampSortsLast() {
        const page = makePage()
        // The lone item is the only one whose group has no header; give it no stamp and
        // it must not lead the list.
        compare(page.stampValue({ kind: "item", row: {} }), -Infinity)
        compare(page.stampValue({ kind: "item", row: { firstSeen: "nope" } }), -Infinity)
        verify(page.stampValue({ kind: "item", row: { firstSeen: "2026-11-03T15:00:00Z" } }) > 0)
        // A task's key is when it was handed over, not when it was last touched.
        verify(page.stampValue({ kind: "task", row: { createdAt: "2026-10-30T15:00:00Z" } })
               > page.stampValue({ kind: "item", row: { firstSeen: "2026-10-20T15:00:00Z" } }))
        page.destroy()
    }

    function test_snoozedRowsLeaveTheOpenList() {
        const page = makePage()
        // The stub reports "snoozed" for any row in that state; the page must take
        // it OUT of the in-play list rather than painting it among the open loops.
        const rows = page.snoozedModel
        compare(rows.length, 0)           // nothing is snoozed in the fixture
        compare(page.inPlayRows.length, 4)
        page.destroy()
    }

    // Depth-first search for a control by its visible text. The rows are Loaders
    // over inline components, so the only honest way to prove "Discuss" is wired is
    // to find the button the user would click and click it.
    function findControl(item, text) {
        if (!item)
            return null
        if (item.text !== undefined && item.text === text)
            return item
        const kids = item.children || []
        for (let i = 0; i < kids.length; i++) {
            const hit = findControl(kids[i], text)
            if (hit)
                return hit
        }
        return null
    }

    function test_discussOpensTheThreadChat() {
        const page = makePage()
        page.toggleLabel("chami-billing")
        wait(50)
        const discuss = findControl(page, qsTr("Discuss"))
        verify(discuss !== null, "the thread header has no Discuss button")
        discuss.clicked()
        compare(Mgr.lastCall, "openThreadChat:chami-billing")
        page.destroy()
    }

    function findByName(item, name) {
        if (!item)
            return null
        if (item.objectName === name)
            return item
        const kids = item.children || []
        for (let i = 0; i < kids.length; i++) {
            const hit = findByName(kids[i], name)
            if (hit)
                return hit
        }
        return null
    }

    // The body of the card for one specific row. Groups are open by default now, so
    // "the first card on the page" is a LABELLED one — a test that grabs it proves
    // nothing about the unlabelled path.
    function findCardBodyFor(item, id) {
        const kids = item.children || []
        for (let i = 0; i < kids.length; i++) {
            const kid = kids[i]
            const owns = kid.row !== undefined && kid.row.id === id
            if (owns) {
                const inner = findByName(kid, "myDayCardBody")
                if (inner)
                    return inner
            }
            const hit = findCardBodyFor(kid, id)
            if (hit)
                return hit
        }
        return null
    }

    function test_aRowTapThroughNamesTheItem() {
        const page = makePage()
        // An unlabelled loop has no thread to open, so the card body goes to the
        // assistant thread — and names the ITEM in the opening line, so the model
        // can state_close on THAT row instead of guessing which loop is meant.
        wait(20)
        const body = findCardBodyFor(page, "itm_c")
        verify(body !== null, "no unlabelled item card body rendered")
        body.clicked(null)
        // Order matters: the chat is chosen first, the item-specific line second.
        verify(Mgr.lastCall.startsWith("setDraft:About item itm_"),
               "unexpected call: " + Mgr.lastCall)
        page.destroy()
    }

    function test_aHandedOverTaskOpensTheSessionThatDidTheWork() {
        const page = makePage()
        // No toggle: the group is open by default, so the card is already there.
        wait(20)
        const body = findByName(page, "myDayTaskBody")
        verify(body !== null, "no handed-over card rendered")
        body.clicked(null)
        compare(Mgr.lastCall, "openTaskSession:20261030_1:chami-billing")
        page.destroy()
    }
}
