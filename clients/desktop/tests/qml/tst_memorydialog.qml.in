import QtQuick
import QtTest
import "@MEMORY_UI_URL@"

// MemoryDialog against the stub Mgr: opens, auto-selects the first topic,
// and pushes its content into the editor. The point is instantiation of the
// dialog's delegates/panes (binding errors there are invisible to qmllint).
TestCase {
    id: tc
    name: "MemoryDialog"
    width: 820
    height: 660

    Component {
        id: dlgComp
        MemoryDialog { }
    }

    function test_openAndSelect() {
        const dlg = dlgComp.createObject(tc)
        dlg.openGlobal()
        waitForRendering(dlg.detailList)
        wait(50)
        // The stub replies synchronously; the dialog auto-selects row 0.
        compare(dlg.topics.length, 2)
        compare(dlg.selected, "Education")
        compare(dlg.origText, "# keywords\nbody for Education\n")
        // Project-scoped entry: opens on the pending topic once the list lands.
        dlg.openForTopic("hacking")
        wait(50)
        compare(dlg.selected, "hacking")
        compare(dlg.detailEditor.text, "# keywords\nbody for hacking\n")
        dlg.destroy()
    }
}
