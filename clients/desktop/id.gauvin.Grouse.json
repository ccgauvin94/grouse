{
  "id": "id.gauvin.Grouse",
  "runtime": "org.kde.Platform",
  "runtime-version": "6.10",
  "sdk": "org.kde.Sdk",
  "base": "io.qt.qtwebengine.BaseApp",
  "base-version": "6.10",
  "command": "grouse-desktop",
  "finish-args": [
    "--share=network",
    "--socket=wayland",
    "--socket=x11",
    "--share=ipc",
    "--device=dri",
    "--socket=pulseaudio",
    "--own-name=id.gauvin.Grouse",
    "--talk-name=org.freedesktop.Notifications",
    "--talk-name=org.unifiedpush.Distributor.kde",
    "--filesystem=~/.local/lib/qt6/plugins:create",
    "--filesystem=xdg-config/plasma-workspace/env:create",
    "--env=QTWEBENGINEPROCESS_PATH=/app/bin/QtWebEngineProcess"
  ],
  "cleanup-commands": [
    "/app/cleanup-BaseApp.sh"
  ],
  "separate-locales": false,
  "modules": [
    {
      "name": "grouserunner",
      "buildsystem": "simple",
      "build-commands": [
        "install -D grouserunner.so /app/lib/grouserunner.so"
      ],
      "sources": [
        {
          "type": "file",
          "path": "krunner-prebuild/grouserunner.so"
        }
      ]
    },
    {
      "name": "grouse-core",
      "buildsystem": "simple",
      "build-commands": [
        "install -D libgrouse_core.so /app/lib/libgrouse_core.so"
      ],
      "sources": [
        {
          "type": "file",
          "path": "grouse-core-prebuild/libgrouse_core.so"
        }
      ]
    },
    {
      "name": "grouse-desktop",
      "buildsystem": "cmake-ninja",
      "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DBUILD_TESTING=OFF",
        "-DBUILD_KRUNNER=OFF"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ]
}
