// swift-tools-version:5.9
//
// TEMPLATED — build.sh writes Package.swift from this file, substituting @LIBDIR@ with the
// absolute path to build/lib (the universal libgrouse_core.a). SwiftPM has no way to say
// "the library next to me", and an unsafeFlags path is the only way to point the linker at
// a local static archive. Committing a generated absolute path would be worse.
//
// The three targets mirror what uniffi's Swift output expects:
//   GrouseCoreFFI  the C headers (grouse_coreFFI.h / grouse_roam_coreFFI.h) + a plain
//                  module map, so the generated Swift's `canImport(grouse_coreFFI)` works.
//   GrouseCore     the generated Swift binding plus ListenerDefaults.swift.
//   grouse-spike   the CLI.
import PackageDescription

let package = Package(
    name: "grouse-spike",
    platforms: [.macOS(.v13)],
    targets: [
        .target(
            name: "GrouseCoreFFI",
            path: "Sources/GrouseCoreFFI",
            publicHeadersPath: "include"
        ),
        .target(
            name: "GrouseCore",
            dependencies: ["GrouseCoreFFI"],
            path: "Sources/GrouseCore",
            linkerSettings: [
                .linkedLibrary("grouse_core"),
                // rustls/ring and iroh reach for these on Darwin.
                .linkedFramework("Security"),
                .linkedFramework("CoreFoundation"),
                .linkedFramework("SystemConfiguration"),
                .unsafeFlags(["-L", "@LIBDIR@"]),
            ]
        ),
        .executableTarget(
            name: "grouse-spike",
            dependencies: ["GrouseCore"],
            path: "Sources/grouse-spike"
        ),
    ]
)
