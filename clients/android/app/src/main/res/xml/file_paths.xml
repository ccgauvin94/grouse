<?xml version="1.0" encoding="utf-8"?>
<!-- The one directory the camera app may write into: our cache, so a capture never
     lands in shared storage and is dropped when the app is cleaned up. -->
<paths>
    <cache-path name="captures" path="captures/" />
    <!-- Files the server SHARED, fetched on demand by the core into
         filesDir/files/ (see ItemKind.FILE). A card opens one by handing this
         provider's content URI to whatever app handles the type. -->
    <files-path name="shared_files" path="files/" />
</paths>
