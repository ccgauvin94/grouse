<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup (API < 31). Exclude the Keystore-backed encrypted prefs: their master key is
     device-bound and never leaves the device, so a restored copy would be undecryptable. -->
<full-backup-content>
    <exclude domain="sharedpref" path="goose_secure.xml" />
    <!-- Chat transcript snapshots (cold-start repaint cache): private content, and the
         server is the source of truth anyway - never ship them to cloud backup. -->
    <exclude domain="file" path="transcripts" />
</full-backup-content>
